      "roundness": null,
      "seed": 1763968998,
      "version": 91,
      "versionNonce": 1192644602,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786401913591,
      "link": null,
      "locked": false,
      "text": "Cenário: \"Uma loja online tem apenas\n1 unidade de um produto. \nDois clientes compram ao\nmesmo tempo. \nLogo depois, ocorre uma falha\n antes de todo o processamento\nterminar.\"",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cenário: \"Uma loja online tem apenas\n1 unidade de um produto. \nDois clientes compram ao\nmesmo tempo. \nLogo depois, ocorre uma falha\n antes de todo o processamento\nterminar.\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
