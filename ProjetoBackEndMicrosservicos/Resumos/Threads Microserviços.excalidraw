    {
      "id": "AH92ZD2OYi3VYjmEOTm1E",
      "type": "text",
      "x": 401.75,
      "y": 909.9861111111111,
      "width": 832.3666381835938,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1x",
      "roundness": null,
      "seed": 1097111120,
      "version": 1053,
      "versionNonce": 1390273200,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786496396469,
      "link": null,
      "locked": false,
      "text": "Após registrar a existência da thread pool, o escalonador fica responsável \npor distribuir essas threads entre os núcleos da CPU. Durante essa \noperação ocorre o Context Switch, no qual o escalonador direciona a 'Thread A' \npara um núcleo. Passa alguns milissegundos, e ele troca para a 'Thread B'. Um \nproblema que é evidente, é que o escalanonador pode criar race conditions, um \nerro de memória no qual uma thread tenta executar uma operação em uma variável\nque já foi alterada, mas não foi registrada na memória por conta do escalonador\nparar o processo antes dele finalizar. De forma resumida, utilizamos classes atômicas,\npara que as instruções sejam concluídas antes do escalonador trocar a tarefa.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Após registrar a existência da thread pool, o escalonador fica responsável \npor distribuir essas threads entre os núcleos da CPU. Durante essa \noperação ocorre o Context Switch, no qual o escalonador direciona a 'Thread A' \npara um núcleo. Passa alguns milissegundos, e ele troca para a 'Thread B'. Um \nproblema que é evidente, é que o escalanonador pode criar race conditions, um \nerro de memória no qual uma thread tenta executar uma operação em uma variável\nque já foi alterada, mas não foi registrada na memória por conta do escalonador\nparar o processo antes dele finalizar. De forma resumida, utilizamos classes atômicas,\npara que as instruções sejam concluídas antes do escalonador trocar a tarefa.",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
