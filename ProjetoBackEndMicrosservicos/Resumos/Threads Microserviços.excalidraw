    {
      "id": "vhIy6pmjE6wINYghfM8q6",
      "type": "text",
      "x": 615.2222222222223,
      "y": 638.3888888888888,
      "width": 549.683349609375,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1v",
      "roundness": null,
      "seed": 1529882288,
      "version": 350,
      "versionNonce": 1811968688,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786496257908,
      "link": null,
      "locked": false,
      "text": "Essas informações são dispostas em uma thread. \nO conjunto de threads forma uma thread pool (em java).\n\nEm resumo: A Thread Pool do Java recicla Threads\ne distribui o seu código para elas. \nO Escalonador distribui essas Threads no processador. \nUm não interfere no trabalho do outro.\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Essas informações são dispostas em uma thread. \nO conjunto de threads forma uma thread pool (em java).\n\nEm resumo: A Thread Pool do Java recicla Threads\ne distribui o seu código para elas. \nO Escalonador distribui essas Threads no processador. \nUm não interfere no trabalho do outro.\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
